{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2025-12-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "name": "paapi-server",
  "main": "dist/server/index.mjs",
  "assets": {
    "directory": "dist/public"
  },
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "$DurableObject",
        "class_name": "$DurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "$DurableObject"
      ]
    }
  ]
}
